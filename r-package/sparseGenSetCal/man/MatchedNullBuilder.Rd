cache <- rank_cache(X$matrix, X$genes, ceiling = 60)
builder <- MatchedNullBuilder$new(cache, det_floor = 0.005, seed = 3)
str(builder$sample(cache$genes[1:8], n_sets = 3), max.level = 1)

}
